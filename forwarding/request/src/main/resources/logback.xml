<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- request：默认只写 logs 目录下文件，不输出控制台。
         目录与级别可通过 JVM 覆盖，例如：-Dforwarding.log.path=./logs -Dforwarding.log.level=INFO -->
    <property name="log.path" value="${forwarding.log.path:-./logs}" />
    <property name="log.maxFileSize" value="${forwarding.log.maxFileSize:-100MB}" />
    <property name="log.maxHistory" value="${forwarding.log.maxHistory:-14}" />
    <property name="log.pattern"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n" />
    <!-- 默认不写控制台，仅写文件；若需临时看控制台可取消下面 console 的注释并在 root 中增加 appender-ref -->
    <!--
    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${log.pattern}</pattern>
        </encoder>
    </appender>
    -->

    <!-- 业务 INFO 及以上写入 rolling 文件（不再误用 LevelFilter 导致全级别落盘） -->
    <appender name="file_info" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/forwarding.request.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${log.path}/forwarding.request.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${log.maxFileSize}</maxFileSize>
            <maxHistory>${log.maxHistory}</maxHistory>
        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${log.pattern}</pattern>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
    </appender>

    <appender name="file_error" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${log.path}/forwarding.request-error.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${log.path}/forwarding.request-error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>${log.maxFileSize}</maxFileSize>
            <maxHistory>${log.maxHistory}</maxHistory>
        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>${log.pattern}</pattern>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
    </appender>

    <!-- forwarding：默认 INFO；排查协议/粘包可临时设为 TRACE（含 payload 预览，勿在生产长期开启） -->
    <logger name="org.wlpiaoyi.framework.forwarding" level="${forwarding.log.level:-INFO}" />

    <root level="${forwarding.root.level:-INFO}">
        <appender-ref ref="file_info" />
        <appender-ref ref="file_error" />
    </root>
</configuration>
